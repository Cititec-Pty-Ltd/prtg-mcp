# Paessler PRTG Network Monitor, classic HTTP API.
# The PRTG web interface address as typed in a browser, https, no path:
# for example https://prtg.example.local (not the API v2 Application Server on :1616).
PRTG_URL=

# An API key of a READ-ONLY PRTG user (PRTG: Setup > Account Settings > My Account >
# API Keys; PRTG 22.1 or later). The key has every right of its user, so create a
# dedicated read-only user first. Sent as the apitoken query parameter; never
# logged or returned.
PRTG_API_TOKEN=

# true only when the PRTG certificate is self-signed or not issued for the name in
# PRTG_URL. The connection is still encrypted, but the server is not authenticated:
# use it only on a trusted network path (VPN).
PRTG_ACCEPT_SELF_SIGNED=false

# The PRTG core server's time zone (IANA name). PRTG reads and writes historic-data
# times in its local time. Default UTC.
PRTG_TIME_ZONE=UTC

# true allows an http:// PRTG_URL. The token then crosses the network in clear text.
PRTG_ALLOW_HTTP=false

# off disables the <prtg-data> untrusted-text wrapper on results.
PRTG_UNTRUSTED_MARKERS=on

# Log level (stderr): debug, info, warn, error. Tool arguments and the token are
# never logged.
LOG_LEVEL=info
